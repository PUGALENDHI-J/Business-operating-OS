# Copy this file to .env.local and fill in your own Supabase project's values.
# Never commit the real .env.local — it's already covered by .gitignore.
#
# Find these under Supabase Dashboard → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe for the frontend.
# NEVER put the service-role key here or anywhere in frontend code (spec Section 37/76).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
