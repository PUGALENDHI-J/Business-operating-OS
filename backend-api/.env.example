# Copy to .env and fill in real values. NEVER commit the real .env file.

NODE_ENV=development
PORT=4000

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=nachiyar_dev
DB_PASSWORD=changeme
DB_NAME=nachiyar_chit
DB_SSL=false

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-generate-a-real-secret
JWT_REFRESH_SECRET=changeme-generate-a-different-real-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Password reset ---
PASSWORD_RESET_EXPIRES_MIN=30

# --- CORS ---
# Comma-separated. Must include both the CRM's origin and the public
# website's origin (Phase 5) — the public site calls the same API's
# /public/* routes directly from the visitor's browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

BCRYPT_SALT_ROUNDS=12

LOG_LEVEL=debug

# --- WhatsApp (Phase 8 — not used by Phase 3 code, declared for later) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
